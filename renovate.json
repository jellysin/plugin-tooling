{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "pin",
  "automerge": false,
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Preserve supported Python runtimes while updating exact CI interpreter pins separately",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "rangeStrategy": "widen"
    },
    {"matchManagers": ["github-actions"], "groupName": "GitHub Actions"},
    {"matchUpdateTypes": ["major"], "groupName": null}
  ]
}
